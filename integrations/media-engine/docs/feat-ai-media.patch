+'use strict';
+const net=require('node:net');
+const {insist}=require('./utils.cjs');
+function call({host='127.0.0.1',port=7420,token,timeoutMs=4000},method,params={}){
+ insist(['127.0.0.1','::1','localhost'].includes(host),'Concat restricted to loopback','FORBIDDEN_NETWORK');
+ insist(typeof token==='string'&&token.length>0,'Concat auth token required','BLOCKED_AUTH');
+ return new Promise((resolve,reject)=>{
+  const socket=net.connect({host,port});let auth=false,finished=false,buffer='';
+  const timer=setTimeout(()=>done(new Error('Concat response timeout')),timeoutMs);
+  function done(err,result){if(finished)return;finished=true;clearTimeout(timer);socket.destroy();if(err)reject(err);else resolve(result);}
+  socket.on('error',done);socket.on('connect',()=>socket.write(JSON.stringify({jsonrpc:'2.0',id:0,method:'auth',params:{token}})+'\n'));
+  socket.on('data',chunk=>{buffer+=chunk.toString('utf8');if(buffer.length>65536)return done(new Error('Concat response overflow'));let i;while((i=buffer.indexOf('\n'))>=0){const line=buffer.slice(0,i);buffer=buffer.slice(i+1);let obj;try{obj=JSON.parse(line)}catch{return done(new Error('Concat invalid JSON'))}if(obj.id===0){if(obj.error)return done(new Error('Concat authentication failed'));auth=true;socket.write(JSON.stringify({jsonrpc:'2.0',id:1,method,params})+'\n');}else if(auth&&obj.id===1)return done(obj.error?new Error(obj.error.message):null,obj.result);}});
+ });
+}
+async function probe(settings){const v=await call(settings,'version');insist(v?.capabilities&&v.capabilities.includes('json-rpc'),'Unsupported Concat API','BLOCKED_CONCAT');return v;}
+module.exports={call,probe};

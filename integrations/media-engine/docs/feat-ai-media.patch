--- /dev/null
+++ b/src/quality.cjs
@@ -0,0 +1,21 @@
+'use strict';
+const {ffprobe,duration,hasAudio,hasVideo,run}=require('./utils.cjs');
+async function check({file,expectedDuration,ffmpegBin='ffmpeg',ffprobeBin='ffprobe',subtitleSegments=null,allowedError=.65}){
+ const p=await ffprobe(file,ffprobeBin),seconds=duration(p),problems=[],warnings=[];
+ if(!hasVideo(p))problems.push('NO_VIDEO');if(!hasAudio(p))problems.push('NO_AUDIO');
+ if(Math.abs(seconds-expectedDuration)>Math.max(.9,expectedDuration*.04))problems.push('DURATION_MISMATCH');
+ let black=[],silent=[];
+ try{
+  const {stderr}=await run(ffmpegBin,['-hide_banner','-nostdin','-i',file,'-vf','blackdetect=d=1.3:pix_th=0.08','-an','-f','null','-'],{timeoutMs:180000});
+  black=[...stderr.matchAll(/black_start:([\d.]+) black_end:([\d.]+)/g)].map(x=>({start:+x[1],end:+x[2]}));
+  if(black.some(x=>x.end-x.start>Math.max(2,seconds*.15)))problems.push('LONG_BLACK_FRAME');
+ }catch(e){warnings.push('BLACKDETECT_UNAVAILABLE: '+e.code)}
+ try{
+  const {stderr}=await run(ffmpegBin,['-hide_banner','-nostdin','-i',file,'-af','silencedetect=noise=-48dB:d=2.0','-vn','-f','null','-'],{timeoutMs:180000});
+  silent=[...stderr.matchAll(/silence_start: ([\d.]+)[\s\S]*?silence_end: ([\d.]+)/g)].map(x=>({start:+x[1],end:+x[2]}));
+  if(silent.some(x=>x.end-x.start>Math.max(4,seconds*.20)))warnings.push('LONG_AUDIO_SILENCE');
+ }catch(e){warnings.push('SILENCEDETECT_UNAVAILABLE: '+e.code)}
+ const sync=[];if(subtitleSegments){for(const s of subtitleSegments){const left=Math.max(0,-s.start),right=Math.max(0,s.end-seconds);sync.push({id:s.id,errorSeconds:Math.max(left,right),method:'clip audio duration boundary; not measured word alignment'});if(left>allowedError||right>allowedError)problems.push('SUBTITLE_OUTSIDE_VIDEO');}}
+ return {passed:problems.length===0,problems,warnings,file,durationSeconds:seconds,videoCodec:p.streams.find(x=>x.codec_type==='video')?.codec_name,audioCodec:p.streams.find(x=>x.codec_type==='audio')?.codec_name,black,silence:silent,subtitleBoundaryChecks:sync,subtitleAccuracyScope:'Segment boundaries inferred from individually probed TTS audio. Phoneme/word alignment NOT measured.'};
+}
+module.exports={check};
diff --git a/src/renderer.cjs b/src/renderer.cjs
new file mode 100644
index 0000000..83a6815
--- /dev/null
+++ b/src/renderer.cjs
@@ -0,0 +1,55 @@
+'use strict';
+const {fs,path,run,sha,insist,mkdir,ffprobe,duration,hasAudio,jsonRead,jsonWrite,shaFile}=require('./utils.cjs');
+const escapeFilterPath=file=>file.replace(/\\/g,'/').replace(/:/g,'\\:').replace(/'/g,"'\\\\''").replace(/,/g,'\\,').replace(/\[/g,'\\[').replace(/\]/g,'\\]');
+const videoFilters=(w,h,motion=false)=>motion?
+ `scale=${Math.round(w*1.2)}:${Math.round(h*1.2)}:force_original_aspect_ratio=increase,crop=${Math.round(w*1.2)}:${Math.round(h*1.2)},zoompan=z='min(zoom+0.00035,1.08)':x='iw/2-(iw/zoom/2)':y='ih/2-(ih/zoom/2)':d=1:s=${w}x${h}:fps=25,format=yuv420p`:
+ `scale=${w}:${h}:force_original_aspect_ratio=decrease,pad=${w}:${h}:(ow-iw)/2:(oh-ih)/2,setsar=1,fps=25,format=yuv420p`;
+async function render({timeline,jobDir,ffmpegBin='ffmpeg',ffprobeBin='ffprobe',preview=false,subtitle=null,music=null,crf=23,maxThreads=2,signal,onProgress=()=>{}}){
+ insist(['story','edit'].includes(timeline.kind),'Unknown timeline type');
+ const w=preview?Math.min(timeline.width,640):timeline.width,h=preview?Math.round(timeline.height*w/timeline.width/2)*2:timeline.height;
+ const clips=timeline.kind==='story'?timeline.scenes:timeline.segments;
+ insist(clips.length>0&&clips.length<=120,'Invalid clip count','LIMIT');
+ const chunks=mkdir(path.join(jobDir,'render-cache',preview?'preview':'final'));
+ const paths=[];let expected=0,reused=0;
+ for(let i=0;i<clips.length;i++){
+  const c=clips[i],length=timeline.kind==='story'?c.duration:c.end-c.start;
+  insist(length>0&&length<=900,'Clip duration invalid','LIMIT');expected+=length;
+  let fingerprint=timeline.kind==='story'?`${c.cacheKey}:${shaFile(c.audio)}:${shaFile(c.image)}`:`${c.source}:${fs.statSync(c.source).size}:${fs.statSync(c.source).mtimeMs}:${c.start}:${c.end}`;
+  fingerprint=sha(JSON.stringify([fingerprint,w,h,preview,crf,ffmpegBin])).slice(0,20);
+  const outfile=path.join(chunks,`${String(i).padStart(4,'0')}-${fingerprint}.mp4`);
+  let valid=false;
+  if(fs.existsSync(outfile))try{const p=await ffprobe(outfile,ffprobeBin);valid=duration(p)>.2&&Math.abs(duration(p)-length)<1.0;}catch{}
+  if(valid)reused++;else{
+   const temp=outfile+'.part.mp4';const args=['-hide_banner','-loglevel','error','-nostdin','-y'];
+   if(timeline.kind==='story'){
+    args.push('-loop','1','-framerate','25','-i',c.image,'-i',c.audio,'-t',String(length),'-vf',videoFilters(w,h,true));
+   }else{
+    const src=await ffprobe(c.source,ffprobeBin);args.push('-ss',String(c.start),'-t',String(length),'-i',c.source);
+    if(!hasAudio(src))args.push('-f','lavfi','-t',String(length),'-i','anullsrc=r=48000:cl=stereo');
+    args.push('-t',String(length),'-vf',videoFilters(w,h,false));
+   }
+   args.push('-c:v','libx264','-threads',String(Math.max(1,Math.min(4,maxThreads))),'-preset',preview?'ultrafast':'veryfast','-crf',String(preview?29:crf),'-r','25','-pix_fmt','yuv420p','-c:a','aac','-b:a','96k','-ar','48000','-ac','2','-shortest','-movflags','+faststart',temp);
+   await run(ffmpegBin,args,{timeoutMs:Math.max(90000,length*12000),signal});
+   fs.renameSync(temp,outfile);
+  }
+  paths.push(outfile);onProgress({phase:'clip',completed:i+1,total:clips.length,reused});
+ }
+ const listFile=path.join(chunks,'concat.txt');fs.writeFileSync(listFile,paths.map(p=>`file '${p.replace(/'/g,"'\\''")}'`).join('\n')+'\n');
+ const merged=path.join(jobDir,preview?'preview-merged.mp4':'final-merged.mp4');
+ await run(ffmpegBin,['-hide_banner','-loglevel','error','-nostdin','-y','-f','concat','-safe','0','-i',listFile,'-c','copy','-movflags','+faststart',merged],{timeoutMs:Math.max(120000,expected*6000),signal});
+ const output=path.join(jobDir,preview?'preview.mp4':'final.mp4');
+ if(subtitle||music){
+  const args=['-hide_banner','-loglevel','error','-nostdin','-y','-i',merged];
+  if(music){args.push('-stream_loop','-1','-i',music)}
+  if(subtitle)args.push('-vf',`subtitles=filename='${escapeFilterPath(subtitle)}'`);
+  if(music){
+    args.push('-filter_complex','[1:a]volume=0.24[bg];[bg][0:a]sidechaincompress=threshold=0.024:ratio=8:attack=50:release=400[duck];[duck][0:a]amix=inputs=2:duration=first:dropout_transition=0[aout]','-map','0:v:0','-map','[aout]');
+  }
+  args.push('-c:v','libx264','-threads',String(Math.max(1,Math.min(4,maxThreads))),'-preset','veryfast','-crf',String(preview?29:crf),'-c:a','aac','-b:a','128k','-shortest','-movflags','+faststart',output);
+  await run(ffmpegBin,args,{timeoutMs:Math.max(120000,expected*14000),signal});
+ }else fs.copyFileSync(merged,output);
+ const result=await ffprobe(output,ffprobeBin),actual=duration(result);
+ insist(Math.abs(actual-expected)<Math.max(1,clips.length*.13),'Render duration differs from timeline','RENDER_INVALID');

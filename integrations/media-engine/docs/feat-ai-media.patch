+ const ratio=p.includes('9:16')||/dọc|vertical/.test(p)?'9:16':p.includes('1:1')?'1:1':'16:9';
+ return {version:1,kind:'edit',origin:'deterministic-rule-not-ai',ratio,segments:spans.map((s,i)=>({id:`clip-${i+1}`,source:media.path,...s})),notes:['Deterministic local fallback; use ProviderGateway for AI-generated plans']};
+}
+async function plan({gateway,prompt,media,analysis}){
+ if(gateway?.invoke){try{const r=await gateway.invoke({capability:'video.edit-plan',input:{prompt,media:{seconds:media.seconds,streams:media.streams},analysis}});
+  if(r?.segments?.length)return validate({...r,origin:'provider-ai'},media);
+ }catch(e){if(e.code!=='BLOCKED_PROVIDER')throw e;}
+ }
+ return validate(naturalPlan(prompt,media,analysis),media);

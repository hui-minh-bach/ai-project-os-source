+'use strict';
+const {insist,finite}=require('./utils.cjs');
+function naturalPlan(prompt,media,analysis){
+ const p=String(prompt||'').toLowerCase();const preferShort=/ngắn|short|reel|tiktok|shorts/.test(p);const removeSilence=/im lặng|silence|khoảng lặng/.test(p);
+ let spans=[{start:0,end:media.seconds}];
+ if(removeSilence){const cuts=(analysis?.cutCandidates||[]).filter(x=>x.end-x.start>.65);let cur=0;spans=[];for(const cut of cuts){if(cut.start-cur>.25)spans.push({start:cur,end:Math.max(cur,cut.start+.05)});cur=Math.min(media.seconds,cut.end-.05);}if(media.seconds-cur>.25)spans.push({start:cur,end:media.seconds});}

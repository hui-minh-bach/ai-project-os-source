+'use strict';
+// ONLY a local integration-test adapter. Production must be supplied with real CoreServices v1 ports.
+const {fs,path,mkdir,sha,insist,jsonWrite}=require('../src/utils.cjs');
+function makeLocalPorts(root,{gateway=null,log=()=>{}}={}){
+ const handlers=new Map(),jobs=[];const artifacts=mkdir(path.join(root,'artifacts'));
+ return {
+  ProviderGateway:gateway||{invoke:async()=>{throw Object.assign(new Error('Model provider not configured'),{code:'BLOCKED_PROVIDER'})}},
+  TaskQueue:{registerTask:(name,handler)=>{insist(!handlers.has(name),'Duplicate media task');handlers.set(name,handler)},async dispatch(name,payload){insist(handlers.has(name),'Unknown task');jobs.push({name,payload});return handlers.get(name)(payload)}},
+  ArtifactStore:{async putFile({jobId,source,name}){const dir=mkdir(path.join(artifacts,String(jobId).replace(/[^a-zA-Z0-9_-]/g,'_')));const target=path.join(dir,path.basename(name||source));if(path.resolve(source)!==path.resolve(target))fs.copyFileSync(source,target);return {uri:target,sha256:sha(fs.readFileSync(target))};},async putJson({jobId,name,data}){const dir=mkdir(path.join(artifacts,String(jobId).replace(/[^a-zA-Z0-9_-]/g,'_')));const dest=path.join(dir,path.basename(name));jsonWrite(dest,data);return {uri:dest,sha256:sha(fs.readFileSync(dest))};}},
+  EventBus:{publish:(event,payload)=>log(event,payload)},
+  _test:{handlers,jobs}
+ };
+}
+module.exports={makeLocalPorts};
diff --git a/adapters/whisper-cli-gateway.cjs b/adapters/whisper-cli-gateway.cjs
new file mode 100644
index 0000000..de52ecb
--- /dev/null
+++ b/adapters/whisper-cli-gateway.cjs
@@ -0,0 +1,19 @@
+'use strict';
+// A sample ProviderGateway implementation owned by the HOST, not a direct Media Engine model call.
+// Requires whisper.cpp whisper-cli and a model the user downloaded and approved.
+const {fs,path,run,insist}=require('../src/utils.cjs');
+const subtitles=require('../src/subtitles.cjs');
+function whisperGateway({exe='whisper-cli',model,outputRoot,timeoutMs=180000}={}){
+ insist(model&&fs.existsSync(model),'Configure and install a real Whisper model explicitly','BLOCKED_STT');
+ insist(outputRoot,'Output root required');
+ fs.mkdirSync(outputRoot,{recursive:true});
+ return {async invoke({capability,input}){
+  insist(capability==='speech.transcribe','This gateway supports transcription only','BLOCKED_PROVIDER');
+  insist(fs.existsSync(input.audio),'Audio missing','INVALID');
+  const stem=path.join(outputRoot,`whisper-${require('node:crypto').randomBytes(8).toString('hex')}`);
+  await run(exe,['-m',model,'-f',input.audio,'-l',input.language||'vi','-osrt','-of',stem],{timeoutMs});
+  const srt=stem+'.srt';insist(fs.existsSync(srt),'Whisper produced no SRT','BLOCKED_STT');
+  const parsed=subtitles.parseSrt(fs.readFileSync(srt,'utf8'));return {segments:parsed,model,source:'whisper.cpp actual ASR'};
+ }};
+}
+module.exports={whisperGateway};
